<Window x:Class="JobHunt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JobHunt" Height="1000" Width="1600" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Closing="OnWindowClosing">

    <Window.Resources>
        <!-- The one button that sends applications — big, blue, and unmistakable. -->
        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0A66C2" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="36,10" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The light-blue edge keeps the button's outline at 3:1+ against the bar (1.4.11). -->
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#5AA9F5" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#004182" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A4A5C" />
                                <Setter Property="Foreground" Value="#9AA7B4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6CB3FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PanelColumn" Width="680" MinWidth="460" MaxWidth="1100" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Setup, recommendations, application log, settings: plain WebView2 + vanilla JS
             (wwwroot/panel.html) — the proven pattern from Automata and KdpPublish. -->
        <wv2:WebView2 x:Name="Panel" Grid.Row="0" Grid.Column="0" />

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" Background="#333"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      AutomationProperties.Name="Panel width" />

        <!-- The job board itself. The WebView2 is created in code for the active applicant, over
             that applicant's own persistent browser profile, so each one signs in once and never
             sees another applicant's session. -->
        <Grid x:Name="BoardHost" Grid.Row="0" Grid.Column="2">
            <TextBlock x:Name="BoardPlaceholder" Foreground="#B8B8B8" FontSize="15" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                       Text="Add an applicant on the left. LinkedIn opens here, signed in as them." />
        </Grid>

        <!-- Native command bar, outside both browser panes. -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#252526" BorderBrush="#333" BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="HuntButton" DockPanel.Dock="Left" Style="{StaticResource BarButton}"
                        Content="_Hunt now" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="OnHuntClicked"
                        ToolTip="Search LinkedIn with this applicant's job requirements (Alt+H)."
                        AutomationProperties.Name="Hunt now" AutomationProperties.AcceleratorKey="Alt+H" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="#C8C8C8" FontSize="13" Text="Starting…"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />

                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource ApplyButton}"
                        Content="_Apply (0)" IsEnabled="False" Click="OnApplyClicked"
                        AutomationProperties.Name="Apply to selected jobs" AutomationProperties.AcceleratorKey="Alt+A" />
                <Border x:Name="DryRunBadge" DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Dry run is on: applications stop before the final submit"
                        Background="#5C4A00" CornerRadius="4" Padding="10,5"
                        ToolTip="Dry run: every application stops just before the final submit. Turn it off in Settings.">
                    <TextBlock Text="DRY RUN" Foreground="#FFD54A" FontWeight="Bold" FontSize="13" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
