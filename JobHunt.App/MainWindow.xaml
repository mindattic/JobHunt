<Window x:Class="JobHunt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        Title="JobHunt" Height="1000" Width="1600" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource MaChrome}" Closing="OnWindowClosing">

    <Window.Resources>
        <!-- JobHunt's brand colour: the Apply button and the active board tab. -->
        <SolidColorBrush x:Key="JobHuntBrand" Color="#0A66C2" />
        <!-- Re-keys the shared primary button's hover for this window. -->
        <SolidColorBrush x:Key="MaAccentHover" Color="#004182" />
        <!-- The one button that sends applications — big, blue, and unmistakable. The light-blue
             edge keeps its outline at 3:1+ against the bar (1.4.11). -->
        <Style x:Key="ApplyButton" TargetType="Button" BasedOn="{StaticResource MaPrimaryButton}">
            <Setter Property="Background" Value="{StaticResource JobHuntBrand}" />
            <Setter Property="BorderBrush" Value="#5AA9F5" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="36,10" />
            <Setter Property="MinWidth" Value="200" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PanelColumn" Width="680" MinWidth="460" MaxWidth="1100" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Setup, recommendations, application log, settings: plain WebView2 + vanilla JS
             (wwwroot/panel.html) — the proven pattern from Automata and KdpPublish. -->
        <wv2:WebView2 x:Name="Panel" Grid.Row="0" Grid.Column="0" />

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" Background="{StaticResource MaChromeBorder}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      AutomationProperties.Name="Panel width" />

        <!-- The job boards themselves. Each board gets its own WebView2, created in code for the
             active applicant over that applicant's own persistent browser profile, so each one
             signs in once and never sees another applicant's session — and kept alive once
             created, so switching board tabs never loses a session. Only an applicant switch
             tears every pane down (a different person's browser profile entirely). -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="BoardTabs" Grid.Row="0" Orientation="Horizontal" Background="{StaticResource MaChrome}" />

            <mc:AddressBar x:Name="BoardAddressBar" Grid.Row="1" ShowBackForward="False" />

            <Grid x:Name="BoardHost" Grid.Row="2">
                <TextBlock x:Name="BoardPlaceholder" Foreground="{StaticResource MaMuted}" FontSize="15" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                           Text="Add an applicant on the left. LinkedIn opens here, signed in as them." />
            </Grid>
        </Grid>

        <!-- Native command bar, outside both browser panes. -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource MaChrome}" BorderBrush="{StaticResource MaChromeBorder}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="HuntButton" DockPanel.Dock="Left" Style="{StaticResource MaButton}"
                        Content="_Hunt now" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="OnHuntClicked"
                        ToolTip="Search LinkedIn with this applicant's job requirements (Alt+H)."
                        AutomationProperties.Name="Hunt now" AutomationProperties.AcceleratorKey="Alt+H" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MaText}" FontSize="13" Text="Starting…"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />

                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource ApplyButton}"
                        Content="_Apply (0)" IsEnabled="False" Click="OnApplyClicked"
                        AutomationProperties.Name="Apply to selected jobs" AutomationProperties.AcceleratorKey="Alt+A" />
                <Border x:Name="DryRunBadge" DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Dry run is on: applications stop before the final submit"
                        Background="#5C4A00" CornerRadius="4" Padding="10,5"
                        ToolTip="Dry run: every application stops just before the final submit. Turn it off in Settings.">
                    <TextBlock Text="DRY RUN" Foreground="#FFD54A" FontWeight="Bold" FontSize="13" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
